<% preheader_lead = @matches.first&.permit_dates ? "on #{@matches.first.permit_dates}" : "soon" %>
<% content_for :preheader do %>Heads up: temporary "No Parking" signs may be going up near <%= @street_address %> <%= preheader_lead %>.<% end %>

<%= render "shared/address_chip", street_address: @street_address, area: @alert.area %>

<% if @matches.size > 1 %>
  <p style="font-size: 12pt; font-weight: bold; margin: 0 0 1em;">
    Temporary &ldquo;No Parking&rdquo; signs may be going up near your address
    for <%= @matches.size %> upcoming CDOT permits.
  </p>

  <% @matches.each_with_index do |match, i| %>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 1.25em;">
      <tr>
        <td style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px 16px;">
          <p style="margin: 0 0 0.75em; font-size: 10pt; color: #6b7280; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">
            Permit <%= i + 1 %> of <%= @matches.size %>
          </p>
          <%= render "match", match: match %>
        </td>
      </tr>
    </table>
  <% end %>
<% else %>
  <p style="font-size: 12pt; font-weight: bold; margin: 0 0 1em;">
    Temporary &ldquo;No Parking&rdquo; signs may be going up near your address
    for an upcoming CDOT permit.
  </p>

  <%= render "match", match: @matches.first %>
<% end %>

<%= render "shared/warning_callout",
      body: "Signs may already be posted, so check your block before parking. If signs are up and you ignore them, your car may be ticketed or towed.".html_safe %>

<p style="font-size: 9pt; color: #6b7280;">
  This is an experimental feature.
  <%= link_to "Opt out anytime.", @manage_url, style: "color: #6b7280;" %>
</p>

<%= render "shared/email_footer",
      disclaimer: true,
      manage_url: @manage_url %>
