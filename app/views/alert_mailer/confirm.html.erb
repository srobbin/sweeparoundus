<% content_for :preheader do %>Confirm your subscription to street sweeping alerts for <%= @formatted_address_area %>.<% end %>

<% if @neighbor_areas.any? %>
  <p>
    Hi! Someone&mdash;hopefully you&mdash;asked to receive Chicago street
    sweeping alerts at <strong><%= @email %></strong> for these areas:
  </p>
  <ul>
    <li><strong><%= @formatted_address_area %></strong></li>
    <% @neighbor_areas.each do |neighbor_area| %>
      <li><strong><%= neighbor_area.name %></strong></li>
    <% end %>
  </ul>
<% else %>
  <p>
    Hi! Someone&mdash;hopefully you&mdash;asked to receive Chicago street
    sweeping alerts at <strong><%= @email %></strong> for
    <strong><%= @formatted_address_area %></strong>.
  </p>
<% end %>

<% if @static_map_url %>
  <p style="margin-bottom: 0;">
    <%= image_tag @static_map_url,
          alt: "Map showing the sweep area for #{@formatted_address_area}",
          width: AlertStaticMap::WIDTH,
          style: "max-width: 100%; height: auto; border: 1px solid #ccc; display: block;" %>
  </p>
  <p style="font-size: 9pt; color: #6b7280; margin-top: 0.25em;">
    The blue <strong>H</strong> marker is your address; the shaded area is the sweep zone.
  </p>
<% end %>

<p style="margin-top: 1.5em;">
  <%= render "shared/button",
        label: "Confirm your subscription#{'s' if @neighbor_areas.any?}",
        url: @confirmation_url %>
</p>

<p>
  We'll email you the day before each sweep. No spam, no account needed.
</p>

<p style="font-size: 9pt; color: #6b7280;">
  Didn't request this? You can ignore this email and nothing will happen.
</p>

<%= render "shared/email_footer", disclaimer: true, coffee_link: false %>
