<% content_for :preheader do %>Your subscription for <%= @area.name %> has been canceled. You can re-subscribe anytime.<% end %>

<p style="font-size: 12pt; font-weight: bold; margin: 0 0 0.75em;">
  Your <%= ENV["SITE_NAME"] %> subscription for <%= @area.name %> has been canceled.
</p>

<p>
  Each year, the City of Chicago redraws its sweeping areas, so we have to
  cancel subscriptions that weren't fully confirmed or didn't have a street
  address. Yours was one of those.
</p>

<p style="margin-top: 1.5em;">
  <%= render "shared/button",
        label: "Re-subscribe",
        url: ENV["SITE_URL"] %>
</p>

<p style="font-size: 9pt; color: #6b7280; margin-top: 0.75em;">
  Day-before reminders &middot; Map of your sweep zone &middot; Always free
</p>

<%= render "shared/email_footer" %>
