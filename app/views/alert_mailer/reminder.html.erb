<% content_for :preheader do %>Heads up: street sweeping for <%= @street_address || @area.name %> begins tomorrow.<% end %>

<%= render "shared/address_chip", street_address: @street_address, area: @area %>

<p style="font-size: 13pt; font-weight: bold; margin: 0 0 1em;">
  Street sweeping starts tomorrow morning.
</p>

<%= render "shared/date_callout", dates: @dates %>

<% if @static_map_url %>
  <p style="margin-bottom: 0;">
    <%= image_tag @static_map_url,
          alt: "Map showing the sweep area for #{@street_address || @area.name}",
          width: AlertStaticMap::WIDTH,
          style: "max-width: 100%; height: auto; border: 1px solid #ccc; display: block;" %>
  </p>
  <p style="font-size: 9pt; color: #6b7280; margin-top: 0.25em;">
    The blue <strong>H</strong> marker is your address; the shaded area is your sweep zone.
  </p>
<% end %>

<%= render "shared/email_footer",
      disclaimer: true,
      manage_url: @manage_url,
      unsubscribe_url: @unsubscribe_url,
      coffee_context: :reminder %>
