<% content_for :preheader do %>The <%= Time.current.year %> Chicago street sweeping schedule is now live.<% end %>

<%= render "shared/address_chip", street_address: @street_address, area: @area %>

<% if @first_sweep_dates.any? %>
  <p style="font-size: 12pt; font-weight: bold; margin: 0 0 0.5em;">
    The <%= Time.current.year %> sweeping schedule is live.
  </p>
  <p style="margin-top: 0;">
    Your first sweep is <strong><%= @first_sweep_dates.first %></strong><% if @first_sweep_dates.size > 1 %>,
    continuing into <strong><%= @first_sweep_dates[1..].to_sentence(two_words_connector: " and ", last_word_connector: ", and ") %></strong><% end %>.
  </p>
<% else %>
  <p style="font-size: 12pt; font-weight: bold; margin: 0 0 0.5em;">
    The <%= Time.current.year %> sweeping schedule is live.
  </p>
  <p style="margin-top: 0;">
    Your subscription has been carried over for the <%= Time.current.year %> season.
  </p>
<% end %>

<p>
  Moved recently? Update your subscription so you keep getting alerts for the
  right address.
</p>

<p style="margin-top: 1.5em;">
  <%= render "shared/button",
        label: "Manage your subscriptions",
        url: @manage_url %>
</p>

<p style="font-size: 9pt; color: #6b7280; margin-top: 0.75em;">
  <%= link_to "View your #{Time.current.year} schedule", @area, style: "color: #6b7280;" %>
</p>

<%= render "shared/email_footer",
      disclaimer: true,
      manage_url: @manage_url,
      unsubscribe_url: @unsubscribe_url %>
