<%#
  Amber callout that surfaces the sweep dates near the top of the
  reminder email. Use plural label even for a single date to keep
  copy stable across the 1- and 2-day cases.

  Locals:
    label: String prefix (defaults to "Sweep dates").
    dates: Array of pre-formatted date strings (required).
%>
<% label = local_assigns.fetch(:label, "Sweep dates") %>
<% dates = local_assigns.fetch(:dates) %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 1.25em;">
  <tr>
    <td style="background-color: #fff7ed; border: 1px solid #fdba74; border-radius: 6px; padding: 12px 16px; color: #7c2d12;">
      <strong><%= label %>:</strong>
      <%= dates.to_sentence(two_words_connector: " and ", last_word_connector: ", and ") %>
    </td>
  </tr>
</table>
