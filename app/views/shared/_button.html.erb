<%#
  Email-safe primary CTA button. A filled blue button rendered as a
  styled <a> tag (no <button>) so it survives Gmail / Outlook stripping.

  Locals:
    label: String shown inside the CTA (required).
    url:   Destination URL (required).
%>
<% label = local_assigns.fetch(:label) %>
<% url   = local_assigns.fetch(:url) %>

<%= link_to label, url,
      style: "display: inline-block; padding: 14px 24px; background-color: #1d4ed8; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 10.5pt; box-shadow: 0 1px 2px rgba(0,0,0,0.08);" %>
