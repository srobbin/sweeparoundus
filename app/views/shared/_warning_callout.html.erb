<%#
  Yellow warning callout. Used in the permit notify email to flag the
  "check your block before parking" advisory so it doesn't get lost
  in surrounding body text.

  Locals:
    body: String or HTML-safe content shown inside the callout.
%>
<% body = local_assigns.fetch(:body) %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 1.25em;">
  <tr>
    <td class="dm-warning" style="background-color: #fefce8; border: 1px solid #facc15; border-radius: 6px; padding: 12px 16px; color: #713f12;">
      <%= body %>
    </td>
  </tr>
</table>
