<%#
  Address line at the top of address-bound mailers (reminder, permit,
  annual_schedule_live). Renders the address (when present) plus a
  link to the area page; falls back to the linked area name alone
  when the alert has no street_address.

  Locals:
    street_address: String or nil.
    area:           Area record (required).
%>
<% street_address = local_assigns[:street_address] %>
<% area           = local_assigns.fetch(:area) %>

<p style="font-size: 9pt; color: #6b7280; margin: 0 0 0.75em;">
  <% if street_address.present? %>
    <strong style="color: #374151;"><%= street_address %></strong> &middot; <%= link_to area.name, area %>
  <% else %>
    <strong><%= link_to area.name, area %></strong>
  <% end %>
</p>
