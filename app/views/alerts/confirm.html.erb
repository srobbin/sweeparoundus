<div class="flex flex-1 flex-col items-center justify-center max-w-6xl mx-auto px-4 text-center">
  <div class="my-8">
    <%= link_to root_path do %><%= image_tag "logo.png", alt: "#{ENV["SITE_NAME"]} logo", class: "mb-2 mx-auto max-w-[280px] sm:max-w-md" %><% end %>
    <div class="text-xl mt-2">
      <% if @alert %>
        Thank you for confirming your <%= @neighbor_alert_ids.present? ? "subscriptions" : "subscription" %>.
      <% else %>
        I'm sorry, we could not find your subscription.
      <% end %>
    </div>
    <div class="flex justify-center mt-7">
      <%= render "shared/buy_us_a_coffee_button" %>
    </div>
  </div>
</div>

